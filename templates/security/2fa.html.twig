{% extends 'shifts/auth.html.twig' %}
{% block authentication %}
<h2>{{ 'shift.account_2fa'|trans }}</h2>
{% if authenticationError %}<div class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>{% endif %}
<form action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
<label class="form-label" for="_auth_code">{{ 'login.2fa_label'|trans }}</label><input id="_auth_code" class="form-control mb-3" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="numeric" required autofocus>
<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
<button class="btn btn-primary" type="submit">{{ 'shift.account_login'|trans }}</button><a class="btn ms-2" href="{{ logoutPath }}">{{ 'cancel'|trans }}</a>
</form>
{% endblock %}
