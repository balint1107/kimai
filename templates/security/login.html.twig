{% extends 'shifts/auth.html.twig' %}
{% block authentication %}
<h2>{{ 'shift.account_login'|trans }}</h2>
{% if error %}<div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
<form action="{{ path('security_check') }}" method="post">
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<input type="hidden" name="_remember_me" value="on">
<label class="form-label" for="shift-username">{{ 'username'|trans }}</label><input id="shift-username" class="form-control mb-3" name="_username" value="{{ last_username|default(app.user ? app.user.userIdentifier : '') }}" autocomplete="username" required autofocus>
<label class="form-label" for="shift-password">{{ 'password'|trans }}</label><input id="shift-password" class="form-control mb-3" type="password" name="_password" autocomplete="current-password" required>
<button class="btn btn-primary w-100" type="submit">{{ 'shift.account_login'|trans }}</button>
</form><p class="text-muted mt-3 mb-0">{{ 'shift.account_recovery'|trans }}</p>
{% endblock %}
