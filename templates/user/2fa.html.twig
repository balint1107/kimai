{% extends 'shifts/layout.html.twig' %}
{% if form %}{% form_theme form 'bootstrap_5_layout.html.twig' %}{% endif %}
{% form_theme deactivate 'bootstrap_5_layout.html.twig' %}
{% block accounting %}
<div class="d-flex gap-2 mb-3"><a class="btn" href="{{ path('shift_account') }}">{{ 'profile.title'|trans }}</a><a class="btn" href="{{ path('shift_calendar') }}">{{ 'shift.calendar'|trans }}</a></div>
<div class="card shift-account-card"><div class="card-body"><h2>{{ 'shift.account_2fa'|trans }}</h2>
{% if user.totpAuthenticationEnabled %}
<p>{{ 'activated'|trans }}</p>{{ form_start(deactivate) }}<button class="btn btn-warning" type="submit">{{ 'deactivate'|trans }}</button>{{ form_end(deactivate) }}
{% elseif form %}
<p>{{ 'profile.2fa_intro'|trans }}</p><img src="{{ qr_code.dataUri }}" alt="{{ 'shift.account_2fa'|trans }}" width="200" height="200"><details class="my-3"><summary>{{ 'shift.account_secret'|trans }}</summary><code>{{ secret }}</code></details>
{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary" type="submit">{{ 'shift.save'|trans }}</button>{{ form_end(form) }}
{% endif %}</div></div>
{% endblock %}
