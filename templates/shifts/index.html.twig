{% extends 'shifts/layout.html.twig' %}
{% block accounting %}
{% set texts = {} %}
{% for key in ['completed','planned','in_progress','cancelled','count','hours','amount','period','category','state','workplace','saved','delete_confirm','overlap','invalid_time','review','save','new_shift','total_amount','all','select_workplace','new_workplace','edit_workplace','time_off','new_event','event','shift_type','delete_event_confirm','google_sync_error'] %}
    {% set texts = texts|merge({(key): ('shift.' ~ key)|trans}) %}
{% endfor %}
<div id="shift-root" data-tab="{{ tab }}" data-token="{{ csrf_token('shifts') }}" data-texts="{{ texts|json_encode|e('html_attr') }}" data-places="{{ places|json_encode|e('html_attr') }}"
     data-data-url="{{ path('shift_data') }}" data-save-url="{{ path('shift_save') }}" data-delete-url="{{ path('shift_delete') }}" data-workplace-url="{{ path('shift_workplace') }}"
     data-xlsx-url="{{ path('shift_export', {format:'xlsx'}) }}" data-csv-url="{{ path('shift_export', {format:'csv'}) }}"
     data-sync-url="{{ path('shift_google_sync') }}" data-time-off-save-url="{{ path('shift_time_off_save') }}" data-time-off-delete-url="{{ path('shift_time_off_delete') }}"
     data-review="{{ review|default(null)|json_encode|e('html_attr') }}">
    <div id="shift-error" class="alert alert-danger d-none" role="alert"></div>
    {% if tab in ['calendar','summary','workplaces'] %}
    <div class="card mb-3"><div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <label>{{ 'shift.from'|trans }}<input id="filter-from" class="form-control" type="date"></label>
        <label>{{ 'shift.to'|trans }}<input id="filter-to" class="form-control" type="date"></label>
        <label>{{ 'shift.workplace'|trans }}<select id="filter-workplace" class="form-select"{% if tab == 'workplaces' %} required{% endif %}><option value="">{{ (tab == 'workplaces' ? 'shift.select_workplace' : 'shift.all')|trans }}</option></select></label>
        <label>{{ 'shift.category'|trans }}<select id="filter-category" class="form-select"><option value="">{{ 'shift.all'|trans }}</option><option>EFO</option><option>Számla</option></select></label>
        <label>{{ 'shift.state'|trans }}<select id="filter-state" class="form-select"><option value="">{{ 'shift.all'|trans }}</option>{% for state in ['completed','planned','in_progress','cancelled'] %}<option value="{{ state }}">{{ ('shift.' ~ state)|trans }}</option>{% endfor %}</select></label>
        <button class="btn" id="filter-reset">{{ 'shift.reset'|trans }}</button>
        <a class="btn" id="export-xlsx" href="{{ path('shift_export', {format:'xlsx'}) }}">XLSX</a><a class="btn" id="export-csv" href="{{ path('shift_export', {format:'csv'}) }}">CSV</a>
    </div></div>
    <div class="row g-2 mb-3" id="shift-totals" aria-live="polite"></div>
    {% endif %}
    {% if tab == 'calendar' %}
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-2 gap-2"><label>{{ 'shift.jump_date'|trans }}<input class="form-control" type="date" id="calendar-date"></label><div class="d-flex gap-2"><button class="btn btn-primary" id="shift-new">{{ 'shift.new_event'|trans }}</button><button type="button" class="btn btn-icon" id="shift-sync" title="{{ 'shift.google_sync_now'|trans }}" aria-label="{{ 'shift.google_sync_now'|trans }}"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 3v6h-6"/><path d="M21 9l-2.64-2.64A9 9 0 1 0 21 12"/></svg></button></div></div>
        <div class="d-flex flex-wrap gap-2 mb-2 shift-calendar-legend">{% for marker in ['weekend','public_holiday','workday','rest_day','time_off','event'] %}<span class="badge shift-marker-{{ marker }}">{{ ('shift.' ~ marker)|trans }}</span>{% endfor %}</div>
        <p id="calendar-swap-notice" class="text-muted d-none">{{ 'shift.swap_notice'|trans }}</p>
        <div class="card"><div class="card-body"><div id="shift-calendar"></div></div></div>
    {% elseif tab == 'summary' %}
        <p class="text-muted">{{ 'shift.completed_total'|trans }}. {{ 'shift.complete_only'|trans }} <a href="{{ path('shift_calendar', {tab:'imports'}) }}">{{ 'shift.imports'|trans }}</a></p>
        <h2>{{ 'shift.monthly'|trans }}</h2><div id="report-months" class="table-responsive card mb-3 shift-summary-scroll" tabindex="0" aria-label="{{ 'shift.monthly'|trans }}"></div>
        <h2>{{ 'shift.yearly'|trans }}</h2><div id="report-years" class="table-responsive card shift-summary-scroll" tabindex="0" aria-label="{{ 'shift.yearly'|trans }}"></div>
    {% elseif tab == 'workplaces' %}
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button id="workplace-new" class="btn btn-primary" type="button">{{ 'shift.new_workplace'|trans }}</button>
            <button id="workplace-edit" class="btn" type="button" disabled>{{ 'shift.edit_workplace'|trans }}</button>
        </div>
        <p id="workplace-prompt" class="alert alert-info">{{ 'shift.select_workplace'|trans }}</p>
        <div id="workplace-reports" class="d-none">
            <p class="text-muted">{{ 'shift.completed_total'|trans }}</p>
            <h2>{{ 'shift.monthly'|trans }}</h2><div id="report-workplaces" class="table-responsive card mb-3 shift-summary-scroll" tabindex="0" aria-label="{{ 'shift.monthly'|trans }}"></div>
            <h2>{{ 'shift.yearly'|trans }}</h2><div id="report-workplace_years" class="table-responsive card shift-summary-scroll" tabindex="0" aria-label="{{ 'shift.yearly'|trans }}"></div>
        </div>
        <dialog id="workplace-dialog" class="shift-dialog" aria-labelledby="workplace-title">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="workplace-title">{{ 'shift.new_workplace'|trans }}</h2><button id="workplace-close" type="button" class="btn-close" aria-label="{{ 'close'|trans }}"></button></div>
            <div id="workplace-error" class="alert alert-danger d-none" role="alert"></div>
            <form id="workplace-form" class="d-flex gap-2 flex-wrap align-items-end">
                <input name="id" type="hidden"><label>{{ 'shift.workplace'|trans }}<input name="name" class="form-control" required maxlength="150"></label>
                <label>{{ 'shift.rate'|trans }}<input name="rate" class="form-control" type="number" min="0" step="1" required></label>
                <label>{{ 'shift.category'|trans }}<select name="category" class="form-select"><option>EFO</option><option>Számla</option></select></label>
                <label>{{ 'shift.color'|trans }}<input name="color" class="form-control form-control-color" type="color" value="#206bc4"></label>
                <button class="btn btn-primary" type="submit">{{ 'shift.save'|trans }}</button>
            </form>
        </dialog>
    {% else %}
        <div class="card mb-3"><div class="card-body">
            <h2>{{ 'shift.upload'|trans }}</h2><p>{{ 'shift.import_help'|trans }}</p>
            <form action="{{ path('shift_upload') }}" method="post" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="_token" value="{{ csrf_token('shifts') }}"><input class="form-control w-auto" name="workbook" type="file" accept=".xlsx" required>
                <button class="btn btn-primary">{{ 'shift.preview'|trans }}</button>
            </form>
        </div></div>
        {% for batch in batches %}<p><a href="{{ path('shift_import', {id:batch.id}) }}">{{ batch.filename }}</a> · {{ batch.createdAt|date('Y-m-d H:i', 'Europe/Budapest') }} · {{ (batch.imported ? 'shift.imported' : 'shift.preview')|trans }}</p>{% endfor %}
    {% endif %}
    <dialog id="shift-dialog" class="shift-dialog" aria-labelledby="shift-editor-title">
        <form id="shift-form">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="shift-editor-title">{{ 'shift.new_event'|trans }}</h2><button type="button" class="btn-close" id="shift-close" aria-label="{{ 'close'|trans }}"></button></div>
            <input name="id" type="hidden"><input name="review_item" type="hidden">
            <div class="row g-3">
                <label class="col-12">{{ 'shift.event_type'|trans }}<select name="event_type" class="form-select"><option value="shift">{{ 'shift.shift_type'|trans }}</option><option value="time_off">{{ 'shift.time_off'|trans }}</option><option value="event">{{ 'shift.event'|trans }}</option></select></label>
                <label class="col-12 d-none" id="event-title-field">{{ 'shift.event_title'|trans }}<input name="title" class="form-control" maxlength="150" disabled></label>
                <label class="col-12 d-none" id="event-color-field">{{ 'shift.color'|trans }}<input name="color" type="color" class="form-control form-control-color" value="#7952b3" disabled></label>
                <label class="col-12 d-none" id="event-all-day-field"><input name="all_day" type="checkbox" class="form-check-input" disabled> {{ 'shift.all_day'|trans }}</label>
                <label class="col-sm-6">{{ 'shift.begin'|trans }}<input name="begin" type="datetime-local" class="form-control" required step="60"></label>
                <label class="col-sm-6">{{ 'shift.end'|trans }}<input name="end" type="datetime-local" class="form-control" required step="60"></label>
                <fieldset id="event-shift-fields" class="col-12"><div class="row g-3">
                    <label class="col-12">{{ 'shift.workplace'|trans }}<select name="workplace" class="form-select" required></select></label>
                    <label class="col-sm-6">{{ 'shift.rate'|trans }}<input name="rate" type="number" class="form-control" min="0" step="1" required></label>
                    <label class="col-sm-6">{{ 'shift.category'|trans }}<select name="category" class="form-select" required><option value="">—</option><option>EFO</option><option>Számla</option></select></label>
                    <label class="col-12"><input name="cancelled" type="checkbox" class="form-check-input"> {{ 'shift.cancelled'|trans }}</label>
                </div></fieldset>
                <p id="event-calendar-help" class="col-12 text-muted d-none mb-0">{{ 'shift.calendar_event_help'|trans }}</p>
                <label class="col-12">{{ 'shift.note'|trans }}<textarea name="note" class="form-control" maxlength="2000"></textarea></label>
            </div>
            <div id="shift-preview" class="alert alert-info mt-3" aria-live="polite"></div>
            <div id="shift-overlap" class="alert alert-warning d-none">{{ 'shift.overlap'|trans }}</div>
            <div id="shift-editor-error" class="alert alert-danger d-none mt-3" role="alert"></div>
            <div class="d-flex gap-2 justify-content-between mt-3"><button type="button" id="shift-delete" class="btn btn-outline-danger">{{ 'delete'|trans }}</button><button type="submit" class="btn btn-primary">{{ 'shift.save'|trans }}</button></div>
        </form>
    </dialog>
</div>
{% endblock %}
