<!doctype html>
<html lang="{{ app.request.locale|replace({'_':'-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'shift.title'|trans }}{% endblock %}</title>
    {% block stylesheets %}{{ encore_entry_link_tags('shift-shell') }}{% endblock %}
    {% block scripts %}{{ encore_entry_script_tags('shift-shell') }}{% endblock %}
</head>
<body>
<main class="shift-shell">
    {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="status">{{ message|trans }}</div>{% endfor %}{% endfor %}
    {% block content %}{% endblock %}
</main>
</body>
</html>
